index 6a2f5907..6549e3f0 100644
--- a/libc/dlopen/dlopen.c
+++ b/libc/dlopen/dlopen.c
@@ -138,6 +138,31 @@ void __dlopen_unlock(void);
 
 static _Thread_local char dlerror_buf[128];
 
+#ifdef __x86_64__
+// Base brute de %fs (ARCH_GET_FS), sans la convention de cosmo.
+static struct CosmoTib *__foreign_get_fs(void) {
+  long ax = 158, base = 0;  // __NR_arch_prctl
+  asm volatile("syscall"
+               : "+a"(ax)
+               : "D"(0x1003), "S"(&base)  // ARCH_GET_FS
+               : "rcx", "r11", "memory");
+  return (struct CosmoTib *)base;
+}
+
+// Appelé par foreign_tramp pour passer au TLS de la libc étrangère.
+dontinstrument void __foreign_set_tls(struct CosmoTib *tib) {
+  if (IsLinux()) {
+    long ax = 158;
+    asm volatile("syscall"
+                 : "+a"(ax)
+                 : "D"(0x1002), "S"(tib)  // ARCH_SET_FS
+                 : "rcx", "r11", "memory");
+  } else {
+    __set_tls(tib);
+  }
+}
+#endif
+
