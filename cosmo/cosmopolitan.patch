   if (!(tmpdir = getenv("TMPDIR")) || !*tmpdir)
@@ -494,9 +519,8 @@ static uint8_t *movimm(uint8_t p[static 16], int reg, uint64_t val) {
 static void *foreign_thunk_sysv(void *func) {
   uint8_t *code, *p;
 #ifdef __x86_64__
-  // it is no longer needed
-  if (1)
-    return func;
+  // Toujours nécessaire sous Linux : la glibc lit son propre bloc de fil
+  // via %fs (fopen() → _IO_link_in), qui n'existe pas dans celui de cosmo.
   // movabs $func,%rax
   // movabs $foreign_tramp,%r10
   // jmp *%r10
@@ -666,7 +690,11 @@ static bool foreign_setup(void) {
     return false;  // if elf_exec() returns, it failed
   }
 #ifdef __x86_64__
-  __foreign.tib = __get_tls();
+  // Depuis que cosmo range son TLS dans %fs, comme la glibc, __get_tls()
+  // (réécrit par fixupobj en lecture de %fs:0x30) et __set_tls() (qui
+  // ajuste l'adresse) ne conviennent plus pour le TLS étranger : on lit la
+  // base brute, et __foreign_set_tls() la remettra telle quelle.
+  __foreign.tib = IsLinux() ? __foreign_get_fs() : __get_tls();
   __set_tls(cosmo_tib);
 #endif
   __foreign.dlopen = foreign_thunk_sysv(__foreign.dlopen);
